--- /dev/null
+++ b/bsd/dev/polaris_gmu_tcm_test.c
@@ -0,0 +1,179 @@
+/* Optional Polaris A630 GMU ITCM test. CPU scanout and FT8716 stay active.
+ * polarisgmutest=1: GCC AON; =2: read-only CX status.
+ * =4: CX cycle; =5: XO clocks; =6: bus requests/reset; =7: owned ITCM test.
+ * Mode 3 stays disabled; mode 7 retains CM3 reset and restores original ITCM.
+ * No firmware start or GPU acceleration.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include "polaris_gmu_tcm_test.h"
+
+extern bool polaris_touch_i2c_board(void);
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern vm_offset_t ml_static_ptovirt(vm_offset_t);
+extern vm_offset_t ml_static_vtop(vm_offset_t);
+extern kern_return_t thread_terminate(thread_t);
+extern int hz;
+void polaris_gmu_test_init(void);
+static int pg_sleep, pg_mode;
+static bool pg_started;
+struct pg_maps { vm_offset_t gcc, gpucc, gmu; };
+
+static uint32_t
+pg_mmio_read(void *ctx, enum pg_block b, uint32_t off)
+{
+    struct pg_maps *m = ctx;
+    vm_offset_t base = b == PG_GCC ? m->gcc : b == PG_GPUCC ? m->gpucc : m->gmu;
+    uint32_t v = *(volatile uint32_t *)(base + off);
+    __asm__ volatile("dmb oshld" ::: "memory");
+    return v;
+}
+static void
+pg_mmio_write(void *ctx, enum pg_block b, uint32_t off, uint32_t value)
+{
+    struct pg_maps *m = ctx;
+    vm_offset_t base = b == PG_GCC ? m->gcc : b == PG_GPUCC ? m->gpucc : m->gmu;
+    __asm__ volatile("dmb oshst" ::: "memory");
+    *(volatile uint32_t *)(base + off) = value;
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+static void pg_delay(__unused void *ctx, uint32_t us) { delay(us); }
+static void
+pg_print(__unused void *ctx, const char *stage, uint32_t a, uint32_t b)
+{
+    printf("POLARIS GMUTEST: %s a=0x%08x b=0x%08x\n", stage, a, b);
+}
+static bool
+pg_prop(DTEntry node, const char *key, void *out, unsigned int need)
+{
+    const void *p = NULL;
+    unsigned int n = 0;
+    if (SecureDTGetProperty(node, key, &p, &n) != kSuccess || p == NULL || n != need)
+        return false;
+    memcpy(out, p, need);
+    return true;
+}
+static const uint32_t *
+pg_firmware(void)
+{
+    DTEntry chosen, map;
+    uint64_t pair[2], dram = 0, size = 0;
+    if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+        SecureDTLookupEntry(NULL, "/chosen/memory-map", &map) != kSuccess ||
+        !pg_prop(map, "GPU-GMU", pair, sizeof(pair)) ||
+        !pg_prop(chosen, "dram-base", &dram, sizeof(dram)) ||
+        !pg_prop(chosen, "dram-size", &size, sizeof(size))) return NULL;
+    /* mkadt --polaris uses the existing 4GiB high-memory bank. */
+    if (!pg_blob_range_valid(dram, size, pair[0], pair[1]))
+        return NULL;
+    /* Use the existing RAM mapping, not an uncached MMIO alias of cached RAM. */
+    vm_offset_t va = ml_static_ptovirt((vm_offset_t)pair[0]);
+    if (va == 0 || ml_static_vtop(va) != (vm_offset_t)pair[0])
+        return NULL;
+    return (const uint32_t *)va;
+}
+static void
+pg_thread(__unused void *arg, __unused wait_result_t wr)
+{
+    struct pg_maps maps = {0};
+    struct pg_io io = { &maps, pg_mmio_read, pg_mmio_write, pg_delay, pg_print };
+    const uint32_t *fw = NULL;
+    uint32_t *saved = NULL;
+    struct pg_itcm_data tcm = {0};
+    uint32_t ahb;
+    enum pg_result result;
+    static const char *const result_name[] = {
+        "TCM verified and restored", "invalid firmware", "config AHB off",
+        "CX not inherited on; no rail vote", "GMU clock busy at handoff",
+        "clock transition failed", "CM3 not held in reset; no TCM write",
+        "retention rejected", "TCM mismatch (restored)", "RESTORE FAILED"
+    };
+    (void)tsleep(&pg_sleep, PZERO, "pgmutest", hz * 3);
+    if (pg_mode == 3 || pg_mode == 7) {
+        fw = pg_firmware();
+        if (fw == NULL) { printf("POLARIS GMUTEST: invalid/missing firmware handoff\n"); goto done; }
+        saved = kalloc_data(PG_WORDS * sizeof(uint32_t), Z_WAITOK | Z_ZERO);
+        if (saved == NULL) { printf("POLARIS GMUTEST: allocation failed\n"); goto done; }
+        if (pg_mode == 7) {
+            tcm.firmware = fw;
+            tcm.saved = saved;
+            if (!pg_itcm_input_valid(&tcm)) {
+                printf("POLARIS GMUTEST: invalid ITCM buffers/vectors; no MMIO\n");
+                goto done;
+            }
+        }
+    }
+    maps.gcc = ml_io_map(0x00100000, 0x90000);
+    if (!maps.gcc) goto done;
+    ahb = pg_mmio_read(&maps, PG_GCC, PG_GCC_AHB);
+    printf("POLARIS GMUTEST: mode=%d cfg_ahb=%08x memnoc=%08x snoc=%08x ddr_axi=%08x pll_vote=%08x\n",
+        pg_mode, ahb, pg_mmio_read(&maps, PG_GCC, PG_GCC_MEMNOC),
+        pg_mmio_read(&maps, PG_GCC, PG_GCC_SNOC),
+        pg_mmio_read(&maps, PG_GCC, PG_GCC_DDR_AXI),
+        pg_mmio_read(&maps, PG_GCC, PG_GCC_PLL_VOTE));
+    if (ahb & PG_CLK_OFF) { printf("POLARIS GMUTEST: stop before GPUCC: config AHB off\n"); goto done; }
+    if (pg_mode == 1) {
+        printf("POLARIS GMUTEST: mode 1 is AON-only; GPUCC/GMU skipped\n");
+        goto done;
+    }
+    maps.gpucc = ml_io_map(0x05090000, 0x9000);
+    if (!maps.gpucc) goto done;
+    if (pg_mode == 2) {
+        (void)pg_cx_status(&io);
+        goto done;
+    }
+    if (pg_mode == 4 || pg_mode == 5 || pg_mode == 6 || pg_mode == 7) {
+        enum pg_cx_result cx_result;
+        if (pg_mode == 5 || pg_mode == 6 || pg_mode == 7) {
+            maps.gmu = ml_io_map(0x0506a000, 0x30000);
+            if (!maps.gmu) goto done;
+        }
+        cx_result = pg_mode == 7 ? pg_owned_itcm_test(&io, &tcm) :
+            pg_mode == 6 ? pg_cx_cycle_with_probe(&io, pg_bus_clock_probe, NULL) :
+            pg_mode == 5 ? pg_cx_cycle_with_probe(&io, pg_clock_probe, NULL) :
+            pg_cx_cycle(&io);
+        printf("POLARIS GMUTEST: CX cycle result=%u (0=on-and-restored, 1=AHB-off, 2=busy, 3=no-power-ACK, 4=restore-failed, 5=held-on, 6=vote-restored-still-on, 7=timing-rejected, 8=input-rejected)\n",
+               (unsigned int)cx_result);
+        if (pg_mode == 7)
+            printf("POLARIS GMUTEST: owned ITCM result=%u (0=not-run, 1=verified-restored, 2=bad-input, 3=unstable-snapshot, 4=retention-rejected, 5=mismatch-restored, 6=reset-uncertain, 7=restore-failed, 8=access-uncertain)\n",
+                   (unsigned int)tcm.result);
+        goto done;
+    }
+    if (pg_mode != 3) goto done;
+    /* Mapping alone does not read GMU; the core gates each MMIO by power/clock state. */
+    maps.gmu = ml_io_map(0x0506a000, 0x30000);
+    if (!maps.gmu) goto done;
+    result = pg_tcm_test(&io, fw, saved);
+    printf("POLARIS GMUTEST: result=%u %s\n", (unsigned int)result, result_name[result]);
+done:
+    if (saved != NULL && !tcm.modified) kfree_data(saved, PG_WORDS * sizeof(uint32_t));
+    if (tcm.modified)
+        printf("POLARIS GMUTEST: ITCM restore incomplete; saved buffer retained\n");
+    if (pg_mode == 7)
+        printf("POLARIS GMUTEST: mode 7 done; no reset/SMMU/PAS/GX writes; no firmware start requested; CPU display retained\n");
+    else
+        printf("POLARIS GMUTEST: done; no reset/firmware/SMMU/PAS/GX writes; CPU display retained\n");
+    (void)thread_terminate(current_thread());
+    thread_block(THREAD_CONTINUE_NULL);
+}
+void
+polaris_gmu_test_init(void)
+{
+    thread_t thread;
+    if (pg_started || !polaris_touch_i2c_board()) return;
+    (void)PE_parse_boot_argn("polarisgmutest", &pg_mode, sizeof(pg_mode));
+    if (pg_mode != 1 && pg_mode != 2 && pg_mode != 4 && pg_mode != 5 && pg_mode != 6 && pg_mode != 7) return;
+    pg_started = true;
+    if (kernel_thread_start(pg_thread, NULL, &thread) == KERN_SUCCESS)
+        thread_deallocate(thread);
+    else printf("POLARIS GMUTEST: cannot start test thread\n");
+}
+#endif
--- /dev/null
+++ b/bsd/dev/polaris_gmu_tcm_test.h
@@ -0,0 +1,749 @@
+/* Polaris GMU ITCM experiment, shared with host fault-injection tests.
+ * Register facts: MiCode c7cb50c18f81 gpucc-sdm845.c/adreno_a6xx.c.
+ * Mode 4 cycles CX; 5 probes XO; 6 owns buses; 7 saves/tests/restores ITCM.
+ * No shared rail votes, reset release, SMMU, or GPU submission.
+ */
+#ifndef POLARIS_GMU_TCM_TEST_H
+#define POLARIS_GMU_TCM_TEST_H
+
+#define PG_WORDS 8192u
+#define PG_GCC_AHB 0x71004u
+#define PG_GCC_MEMNOC 0x7100cu
+#define PG_GCC_SNOC 0x71018u
+#define PG_GCC_DDR_AXI 0x44038u
+#define PG_GCC_PLL_VOTE 0x52004u
+#define PG_CX_GDSCR 0x106cu
+#define PG_CX_HW 0x1540u
+#define PG_GMU_CLK 0x1098u
+#define PG_CXO_CLK 0x109cu
+#define PG_RCG 0x1120u
+#define PG_CFG_MASK 0x371fu
+#define PG_XO_CFG 1u /* BI_TCXO, HID divide-by-one per MiCode freq table */
+#define PG_CLK_OFF (1u << 31) /* CBCR halt status: 1 = clock off. */
+#define PG_GDSC_PWR_ON (1u << 31) /* GDSCR status: 1 = domain on. */
+#define PG_SW_COLLAPSE 1u
+#define PG_GDSC_CONTROL_MASK (3u << 1) /* HW_CONTROL + SW_OVERRIDE */
+#define PG_CX_WAIT_MASK (15u << 12)
+#define PG_CX_WAIT_VALUE (8u << 12) /* live DT qcom,clk-dis-wait-val */
+#define PG_CX_TIMEOUT_US 500u /* live DT qcom,gds-timeout */
+#define PG_CX_DISABLE_US 100u /* vendor no-status-check-on-disable delay */
+#define PG_DRAM_BASE 0x100000000ULL
+#define PG_DRAM_SIZE6 0x7cc00000ULL
+#define PG_DRAM_SIZE8 0xfcc00000ULL
+#define PG_GMU_BLOB_SIZE (PG_WORDS * 4u)
+#define PG_RESET 0x14000u /* A6XX_GMU_CM3_SYSRESET * 4 - 0x6a000 */
+#define PG_RETENTION 0x14730u /* A6XX_GMU_GENERAL_7 * 4 - 0x6a000 */
+#define PG_ITCM 0x3000u /* A6XX_GMU_CM3_ITCM_START * 4 - 0x6a000 */
+
+enum pg_block { PG_GCC, PG_GPUCC, PG_GMU };
+enum pg_result {
+    PG_OK, PG_BAD_FW, PG_NO_AHB, PG_NO_CX, PG_BUSY,
+    PG_CLOCK_ERROR, PG_NOT_RESET, PG_RETAIN_ERROR, PG_VERIFY_ERROR,
+    PG_RESTORE_ERROR
+};
+struct pg_io {
+    void *ctx;
+    uint32_t (*read)(void *, enum pg_block, uint32_t);
+    void (*write)(void *, enum pg_block, uint32_t, uint32_t);
+    void (*wait_us)(void *, uint32_t);
+    void (*report)(void *, const char *, uint32_t, uint32_t);
+};
+static uint32_t pg_read(struct pg_io *io, enum pg_block b, uint32_t o)
+{ return io->read(io->ctx, b, o); }
+static void pg_write(struct pg_io *io, enum pg_block b, uint32_t o, uint32_t v)
+{ io->write(io->ctx, b, o, v); }
+static void pg_report(struct pg_io *io, const char *tag, uint32_t a, uint32_t b)
+{ io->report(io->ctx, tag, a, b); }
+static bool pg_cx_on(uint32_t cx)
+{
+    /* MiCode c7cb50c18f81 gdsc-regulator.c:168-187. */
+    return (cx & PG_GDSC_PWR_ON) && !(cx & PG_SW_COLLAPSE);
+}
+static bool pg_cx_status(struct pg_io *io)
+{
+    uint32_t cx = pg_read(io, PG_GPUCC, PG_CX_GDSCR);
+    pg_report(io, "CX GDSCR", cx, 0);
+    if (!pg_cx_on(cx)) {
+        pg_report(io, "CX off/collapsing; further GPUCC/GMU withheld", cx, 0);
+        return false;
+    }
+    pg_report(io, "CX HW control", pg_read(io, PG_GPUCC, PG_CX_HW), 0);
+    pg_report(io, "GMU/CXO clocks", pg_read(io, PG_GPUCC, PG_GMU_CLK),
+              pg_read(io, PG_GPUCC, PG_CXO_CLK));
+    pg_report(io, "GMU RCG", pg_read(io, PG_GPUCC, PG_RCG),
+              pg_read(io, PG_GPUCC, PG_RCG + 4));
+    return true;
+}
+enum pg_cx_result {
+    PG_CX_RESTORED, PG_CX_AHB_OFF, PG_CX_BUSY, PG_CX_NO_ACK,
+    PG_CX_RESTORE_FAILED, PG_CX_HELD_ON, PG_CX_VOTE_RESTORED_ON,
+    PG_CX_CONFIG_FAILED, PG_CX_INPUT_REJECTED
+};
+static enum pg_cx_result
+pg_cx_cycle_with_probe(struct pg_io *io,
+                       bool (*probe)(struct pg_io *, void *), void *arg)
+{
+    uint32_t before, now, hw = 0, clock;
+    bool powered = false, timing_changed;
+    enum pg_cx_result result = PG_CX_NO_ACK;
+    /* MiCode gdsc-regulator.c: enable 194-354, disable 357-437,
+     * DT clock-disable wait programming 675-684. CX has no root/reset
+     * sequence, HW status +0x1540, timeout 500us, wait value 8, and
+     * no-status-check-on-disable. Shared parent votes stay untouched.
+     */
+    if (pg_read(io, PG_GCC, PG_GCC_AHB) & PG_CLK_OFF)
+        return PG_CX_AHB_OFF;
+    before = pg_read(io, PG_GPUCC, PG_CX_GDSCR);
+    pg_report(io, "CX cycle before", before, 0);
+    if ((before & (PG_GDSC_PWR_ON | PG_GDSC_CONTROL_MASK)) ||
+        !(before & PG_SW_COLLAPSE)) return PG_CX_BUSY;
+    timing_changed = (before & PG_CX_WAIT_MASK) != PG_CX_WAIT_VALUE;
+    now = before;
+    if (timing_changed) {
+        pg_write(io, PG_GPUCC, PG_CX_GDSCR,
+                 (before & ~PG_CX_WAIT_MASK) | PG_CX_WAIT_VALUE);
+        now = pg_read(io, PG_GPUCC, PG_CX_GDSCR);
+        pg_report(io, "CX cycle timing configured", before, now);
+        if ((now & (PG_GDSC_PWR_ON | PG_GDSC_CONTROL_MASK)) ||
+            !(now & PG_SW_COLLAPSE)) return PG_CX_HELD_ON;
+        if ((now & PG_CX_WAIT_MASK) != PG_CX_WAIT_VALUE) {
+            result = PG_CX_CONFIG_FAILED;
+            goto restore_timing;
+        }
+    }
+    pg_write(io, PG_GPUCC, PG_CX_GDSCR, now & ~PG_SW_COLLAPSE);
+    io->wait_us(io->ctx, 1); /* >=8 XO cycles before status polling */
+    now = pg_read(io, PG_GPUCC, PG_CX_GDSCR);
+    if (now == 0xffffffffu || (now & PG_GDSC_CONTROL_MASK))
+        return PG_CX_HELD_ON;
+    if (!(now & PG_SW_COLLAPSE)) {
+        for (unsigned int us = 0; us < PG_CX_TIMEOUT_US; ++us) {
+            /* This is the GPUCC status alias, not GMU MMIO. */
+            hw = pg_read(io, PG_GPUCC, PG_CX_HW);
+            if (hw == 0xffffffffu) break;
+            if (hw & PG_GDSC_PWR_ON) {
+                now = pg_read(io, PG_GPUCC, PG_CX_GDSCR);
+                powered = pg_cx_on(now);
+                break;
+            }
+            io->wait_us(io->ctx, 1);
+        }
+    }
+    pg_report(io, "CX cycle power ACK", now, hw);
+    if (hw == 0xffffffffu || ((hw & PG_GDSC_PWR_ON) && !powered))
+        return PG_CX_HELD_ON;
+    if (powered) {
+        /* Never collapse a newly visible domain with an active/requested
+         * GMU clock. The nested probe must restore its resources before collapse.
+         */
+        clock = pg_read(io, PG_GPUCC, PG_GMU_CLK);
+        pg_report(io, "CX cycle GMU clock", clock, 0);
+        if (clock == 0xffffffffu || (clock & 1u) || !(clock & PG_CLK_OFF))
+            return PG_CX_HELD_ON;
+        io->wait_us(io->ctx, 2); /* staggered memory power-up delay */
+        if (probe != NULL && !probe(io, arg)) return PG_CX_HELD_ON;
+        result = PG_CX_RESTORED;
+    }
+    now = pg_read(io, PG_GPUCC, PG_CX_GDSCR);
+    if (now == 0xffffffffu || (now & PG_GDSC_CONTROL_MASK))
+        return PG_CX_HELD_ON;
+    if ((now & PG_GDSC_PWR_ON) && !powered) return PG_CX_HELD_ON;
+    /* First restore collapse while retaining the DT-required wait value. */
+    io->wait_us(io->ctx, 1); /* vendor staggered memory power-down delay */
+    pg_write(io, PG_GPUCC, PG_CX_GDSCR,
+             (now & ~PG_GDSC_PWR_ON) | PG_SW_COLLAPSE);
+    io->wait_us(io->ctx, 1); /* >=8 XO cycles before disable settling */
+    io->wait_us(io->ctx, PG_CX_DISABLE_US);
+    now = pg_read(io, PG_GPUCC, PG_CX_GDSCR);
+    pg_report(io, "CX cycle restored collapse", before, now);
+    if (now == 0xffffffffu || !(now & PG_SW_COLLAPSE))
+        return PG_CX_RESTORE_FAILED;
+    /* Another TZ/HYP vote may hold the domain on. Do not force it off or
+     * alter timing while someone else may still be using the domain.
+     */
+    hw = pg_read(io, PG_GPUCC, PG_CX_HW);
+    pg_report(io, "CX cycle final HW status", hw, 0);
+    if (hw == 0xffffffffu) return PG_CX_RESTORE_FAILED;
+    if ((now | hw) & PG_GDSC_PWR_ON) return PG_CX_VOTE_RESTORED_ON;
+restore_timing:
+    if (timing_changed) {
+        now = pg_read(io, PG_GPUCC, PG_CX_GDSCR);
+        if ((now & (PG_GDSC_PWR_ON | PG_GDSC_CONTROL_MASK)) ||
+            !(now & PG_SW_COLLAPSE)) return PG_CX_HELD_ON;
+        pg_write(io, PG_GPUCC, PG_CX_GDSCR,
+                 (now & ~PG_CX_WAIT_MASK) | (before & PG_CX_WAIT_MASK));
+        now = pg_read(io, PG_GPUCC, PG_CX_GDSCR);
+        if (now == 0xffffffffu ||
+            (now & (PG_GDSC_PWR_ON | PG_GDSC_CONTROL_MASK)) ||
+            (now & PG_CX_WAIT_MASK) != (before & PG_CX_WAIT_MASK) ||
+            !(now & PG_SW_COLLAPSE)) return PG_CX_RESTORE_FAILED;
+    }
+    pg_report(io, "CX cycle final GDSCR", before, now);
+    return result;
+}
+static enum pg_cx_result pg_cx_cycle(struct pg_io *io)
+{ return pg_cx_cycle_with_probe(io, NULL, NULL); }
+static bool pg_poll(struct pg_io *io, enum pg_block b, uint32_t o,
+                    uint32_t mask, uint32_t expected)
+{
+    for (unsigned int i = 0; i < 200; i++) {
+        if ((pg_read(io, b, o) & mask) == expected) return true;
+        io->wait_us(io->ctx, 10);
+    }
+    return false;
+}
+/* Update only owned writable fields; never write a saved read-only status bit. */
+static void pg_masked(struct pg_io *io, uint32_t o, uint32_t mask, uint32_t value)
+{
+    uint32_t now = pg_read(io, PG_GPUCC, o);
+    pg_write(io, PG_GPUCC, o, (now & ~mask) | (value & mask));
+}
+static bool pg_update_rcg(struct pg_io *io, uint32_t fields)
+{
+    pg_masked(io, PG_RCG + 4, PG_CFG_MASK, fields);
+    pg_write(io, PG_GPUCC, PG_RCG, pg_read(io, PG_GPUCC, PG_RCG) | 1u);
+    return pg_poll(io, PG_GPUCC, PG_RCG, 1u, 0) &&
+        (pg_read(io, PG_GPUCC, PG_RCG + 4) & PG_CFG_MASK) == (fields & PG_CFG_MASK);
+}
+/* MiCode c7cb50c18f81: gpucc-sdm845.c:220-245,414-429,458-469,820-824;
+ * clk-rcg2.c:109-175,492-565 and clk-branch.c:65-140. The XO parent is
+ * always on while APPS is online. Refuse other parents or inherited use.
+ * Unlike the vendor warning-only RCG path, every timeout fails closed.
+ */
+#define PG_ROOT_OFF (1u << 31)
+#define PG_ROOT_EN 2u
+#define PG_RCG_RO (PG_ROOT_OFF | 0xf0u)
+#define PG_CBCR_RO 0xf0000000u
+#define PG_GMU_WAIT_MASK 0xff0u
+#define PG_CFG_NON_XO (0x3700u | (1u << 20))
+static bool pg_clk_poll(struct pg_io *io, uint32_t off, uint32_t mask, uint32_t val)
+{
+    for (unsigned int us = 0; us < 500; ++us) {
+        uint32_t got = pg_read(io, PG_GPUCC, off);
+        if (got == 0xffffffffu) return false;
+        if ((got & mask) == val) return true;
+        io->wait_us(io->ctx, 1);
+    }
+    return false;
+}
+static bool pg_clk_mask(struct pg_io *io, uint32_t off, uint32_t mask, uint32_t val)
+{
+    uint32_t now = pg_read(io, PG_GPUCC, off);
+    uint32_t ro = off == PG_RCG ? PG_RCG_RO :
+        (off == PG_GMU_CLK || off == PG_CXO_CLK) ? PG_CBCR_RO : 0;
+    if (now == 0xffffffffu) return false;
+    pg_write(io, PG_GPUCC, off, (now & ~(mask | ro)) | (val & mask));
+    return true;
+}
+static bool pg_clk_force(struct pg_io *io, bool on)
+{
+    if (!pg_clk_mask(io, PG_RCG, PG_ROOT_EN, on ? PG_ROOT_EN : 0)) return false;
+    return pg_clk_poll(io, PG_RCG, PG_ROOT_EN | PG_ROOT_OFF,
+                       on ? PG_ROOT_EN : PG_ROOT_OFF);
+}
+static bool pg_clk_config(struct pg_io *io, uint32_t cfg)
+{
+    if (!pg_clk_mask(io, PG_RCG + 4, PG_CFG_MASK, cfg) ||
+        !pg_clk_mask(io, PG_RCG, 1u, 1u)) return false;
+    return pg_clk_poll(io, PG_RCG, 1u, 0) &&
+        (pg_read(io, PG_GPUCC, PG_RCG + 4) & PG_CFG_MASK) == (cfg & PG_CFG_MASK);
+}
+/* Final Polaris DT gcc-sdm845-v2.1 IDs AXI=26/MEMNOC=41 match Lineage
+ * aa8adfe9bf212c6e93238a86980b4024da4f819a. gcc-sdm845.c:1786,1993,2006
+ * and MiCode c7cb50c18f81 agree on offsets, bit0 and voted/halt semantics.
+ * Order: AXI, MEMNOC (GMU DT order), then extra SNOC as Polaris 0138.
+ */
+enum pg_bus_result { PG_BUS_NOT_READY, PG_BUS_RESET_VERIFIED, PG_BUS_HELD };
+static const uint32_t pg_bus_offsets[3] = {
+    PG_GCC_DDR_AXI, PG_GCC_MEMNOC, PG_GCC_SNOC
+};
+static bool pg_bus_request(struct pg_io *io, uint32_t off, bool enable)
+{
+    uint32_t now = pg_read(io, PG_GCC, off);
+    if (now == 0xffffffffu) return false;
+    pg_write(io, PG_GCC, off, (now & ~(PG_CBCR_RO | 1u)) | (enable ? 1u : 0u));
+    return true;
+}
+static bool pg_bus_poll(struct pg_io *io, uint32_t off, bool enable)
+{
+    uint32_t expected = enable ? 1u : PG_CLK_OFF;
+    for (unsigned int us = 0; us < 500; ++us) {
+        uint32_t now = pg_read(io, PG_GCC, off);
+        if (now == 0xffffffffu) return false;
+        if ((now & (PG_CLK_OFF | 1u)) == expected) return true;
+        io->wait_us(io->ctx, 1);
+    }
+    return false;
+}
+static enum pg_bus_result pg_bus_probe(struct pg_io *io,
+    bool (*action)(struct pg_io *, void *), void *arg)
+{
+    uint32_t before[3], now, reset;
+    bool owned[3] = {false, false, false};
+    bool verified = false;
+    for (unsigned int i = 0; i < 3; ++i) {
+        before[i] = pg_read(io, PG_GCC, pg_bus_offsets[i]);
+        pg_report(io, "bus probe inherited (a=offset)", pg_bus_offsets[i], before[i]);
+        if (before[i] == 0xffffffffu) return PG_BUS_NOT_READY;
+    }
+    for (unsigned int i = 0; i < 3; ++i) {
+        now = pg_read(io, PG_GCC, pg_bus_offsets[i]);
+        /* Never toggle an inherited or externally changed local request. */
+        if (now == 0xffffffffu || (now & 1u) != (before[i] & 1u)) goto restore;
+        if (!(before[i] & 1u)) {
+            owned[i] = true;
+            if (!pg_bus_request(io, pg_bus_offsets[i], true)) goto held;
+        }
+        if (!pg_bus_poll(io, pg_bus_offsets[i], true)) {
+            pg_report(io, "bus probe not ready (a=offset)", pg_bus_offsets[i],
+                      pg_read(io, PG_GCC, pg_bus_offsets[i]));
+            goto restore;
+        }
+    }
+    /* Recheck all three before reset MMIO and the optional ITCM action. */
+    for (unsigned int i = 0; i < 3; ++i) {
+        now = pg_read(io, PG_GCC, pg_bus_offsets[i]);
+        pg_report(io, "bus probe ready check (a=offset)", pg_bus_offsets[i], now);
+        if (now == 0xffffffffu || (now & (PG_CLK_OFF | 1u)) != 1u) goto restore;
+    }
+    reset = pg_read(io, PG_GMU, PG_RESET);
+    pg_report(io, "bus probe CM3 SYSRESET", reset, 0);
+    if (reset != 1u) {
+        pg_report(io, "bus probe reset unknown; buses/clocks/CX retained", reset, 0);
+        return PG_BUS_HELD;
+    }
+    if (action != NULL) {
+        if (!action(io, arg)) {
+            pg_report(io, "bus probe action incomplete; dependencies retained", 0, 0);
+            return PG_BUS_HELD;
+        }
+        reset = pg_read(io, PG_GMU, PG_RESET);
+        if (reset != 1u) {
+            pg_report(io, "bus probe reset changed after action; dependencies retained", reset, 0);
+            return PG_BUS_HELD;
+        }
+    }
+    verified = true;
+restore:
+    for (unsigned int count = 3; count > 0; --count) {
+        unsigned int i = count - 1;
+        if (!owned[i]) continue;
+        if (!pg_bus_request(io, pg_bus_offsets[i], false)) goto held;
+        if (i < 2) {
+            /* DDR/MEMNOC BRANCH_VOTED: another voter may keep CLK_OFF=0.
+             * Vendor clk_branch_wait uses only 10us when withdrawing.
+             */
+            io->wait_us(io->ctx, 10);
+        } else if (!pg_bus_poll(io, pg_bus_offsets[i], false)) goto held;
+        now = pg_read(io, PG_GCC, pg_bus_offsets[i]);
+        pg_report(io, "bus probe request restored (a=offset)", pg_bus_offsets[i], now);
+        if (now == 0xffffffffu || (now & 1u)) goto held;
+    }
+    for (unsigned int i = 0; i < 3; ++i) {
+        now = pg_read(io, PG_GCC, pg_bus_offsets[i]);
+        pg_report(io, "bus probe final (a=offset)", pg_bus_offsets[i], now);
+        if (now == 0xffffffffu || (now & 1u) != (before[i] & 1u)) goto held;
+    }
+    pg_report(io, "bus probe requests restored (a=reset-verified)", verified ? 1u : 0u, 0);
+    return verified ? PG_BUS_RESET_VERIFIED : PG_BUS_NOT_READY;
+held:
+    pg_report(io, "bus probe restore uncertain; clocks/CX retained", 0, 0);
+    return PG_BUS_HELD;
+}
+/* True permits the enclosing owned CX cycle to collapse. False leaves the
+ * domain available because clock ownership/restoration is uncertain.
+ */
+static bool pg_clock_probe_body(struct pg_io *io, bool acquire_bus,
+    bool (*action)(struct pg_io *, void *), void *arg)
+{
+    uint32_t gmu, cxo, cfg, cmd, reset, phase = 1;
+    bool timing = false, force = false, configured = false;
+    bool cxo_owned = false, gmu_owned = false, verified = false;
+    if (!pg_cx_on(pg_read(io, PG_GPUCC, PG_CX_GDSCR)) ||
+        !(pg_read(io, PG_GPUCC, PG_CX_HW) & PG_GDSC_PWR_ON)) return false;
+    gmu = pg_read(io, PG_GPUCC, PG_GMU_CLK);
+    cxo = pg_read(io, PG_GPUCC, PG_CXO_CLK);
+    cmd = pg_read(io, PG_GPUCC, PG_RCG);
+    cfg = pg_read(io, PG_GPUCC, PG_RCG + 4);
+    pg_report(io, "clock probe inherited branches", gmu, cxo);
+    pg_report(io, "clock probe inherited RCG", cmd, cfg);
+    /* ROOT_OFF excludes active downstream consumers, including GX GMU.
+     * Only an idle, unforced XO source can be acquired without PLL votes.
+     */
+    if (gmu == 0xffffffffu || cxo == 0xffffffffu ||
+        (gmu & 1u) || !(gmu & PG_CLK_OFF) || cmd != PG_ROOT_OFF ||
+        (cfg & PG_CFG_NON_XO)) {
+        pg_report(io, "clock probe busy; CX retained", cmd, cfg);
+        return false;
+    }
+    if ((gmu & PG_GMU_WAIT_MASK) != PG_GMU_WAIT_MASK) {
+        timing = true;
+        if (!pg_clk_mask(io, PG_GMU_CLK, PG_GMU_WAIT_MASK, PG_GMU_WAIT_MASK)) goto held;
+        if ((pg_read(io, PG_GPUCC, PG_GMU_CLK) &
+             (PG_GMU_WAIT_MASK | PG_CLK_OFF | 1u)) !=
+            (PG_GMU_WAIT_MASK | PG_CLK_OFF)) goto restore;
+    }
+    pg_report(io, "clock probe branch timing", gmu, pg_read(io, PG_GPUCC, PG_GMU_CLK));
+    phase = 2;
+    force = true;
+    if (!pg_clk_force(io, true)) goto restore;
+    phase = 3;
+    configured = true;
+    if (!pg_clk_config(io, PG_XO_CFG)) goto restore;
+    phase = 4;
+    if (!pg_clk_force(io, false)) goto restore;
+    force = false;
+    phase = 5;
+    if (!(cxo & 1u)) {
+        cxo_owned = true;
+        if (!pg_clk_mask(io, PG_CXO_CLK, 1u, 1u)) goto held;
+    }
+    if (!pg_clk_poll(io, PG_CXO_CLK, PG_CLK_OFF | 1u, 1u)) goto restore;
+    phase = 6;
+    gmu_owned = true;
+    if (!pg_clk_mask(io, PG_GMU_CLK, 1u, 1u)) goto held;
+    if (!pg_clk_poll(io, PG_GMU_CLK, PG_CLK_OFF | 1u, 1u)) goto restore;
+    pg_report(io, "clock probe XO ready", pg_read(io, PG_GPUCC, PG_GMU_CLK),
+              pg_read(io, PG_GPUCC, PG_CXO_CLK));
+    pg_report(io, "clock probe XO RCG", pg_read(io, PG_GPUCC, PG_RCG),
+              pg_read(io, PG_GPUCC, PG_RCG + 4));
+    phase = 7;
+    if (acquire_bus) {
+        enum pg_bus_result br = pg_bus_probe(io, action, arg);
+        if (br == PG_BUS_HELD) return false;
+        verified = br == PG_BUS_RESET_VERIFIED;
+        goto restore;
+    }
+    /* MiCode GMU DT and Polaris 0138 also prepare AXI/MEMNOC/SNOC.
+     * Do not infer GMU bus reachability from the core clock alone.
+     * This mode never acquires or writes those GCC clocks.
+     */
+    if ((pg_read(io, PG_GCC, PG_GCC_MEMNOC) |
+         pg_read(io, PG_GCC, PG_GCC_SNOC) |
+         pg_read(io, PG_GCC, PG_GCC_DDR_AXI)) & PG_CLK_OFF) {
+        pg_report(io, "clock probe GMU read withheld; bus clocks not confirmed", 0, 0);
+        goto restore;
+    }
+    /* Only GMU read in this mode. Do not infer reset from a log label. */
+    reset = pg_read(io, PG_GMU, PG_RESET);
+    pg_report(io, "clock probe CM3 SYSRESET", reset, 0);
+    if (reset != 1u) {
+        pg_report(io, "clock probe reset not confirmed; clocks/CX retained", reset, 0);
+        return false;
+    }
+    verified = true;
+restore:
+    pg_report(io, "clock probe restore begins (a=phase)", phase, verified ? 1u : 0u);
+    if (gmu_owned) {
+        if (!pg_clk_mask(io, PG_GMU_CLK, 1u, 0)) goto held;
+        if (!pg_clk_poll(io, PG_GMU_CLK, PG_CLK_OFF | 1u, PG_CLK_OFF)) goto held;
+    }
+    if (configured) {
+        /* Do not issue another update while the preceding one is pending. */
+        cmd = pg_read(io, PG_GPUCC, PG_RCG);
+        if (cmd == 0xffffffffu || (cmd & 1u)) goto held;
+        force = true;
+        if (!pg_clk_force(io, true) || !pg_clk_config(io, cfg)) goto held;
+    }
+    if (force) {
+        if (!pg_clk_force(io, false)) goto held;
+    }
+    if (cxo_owned) {
+        if (!pg_clk_mask(io, PG_CXO_CLK, 1u, 0)) goto held;
+        if (!pg_clk_poll(io, PG_CXO_CLK, PG_CLK_OFF | 1u, PG_CLK_OFF)) goto held;
+    }
+    if (timing) {
+        if ((pg_read(io, PG_GPUCC, PG_GMU_CLK) & (PG_CLK_OFF | 1u)) != PG_CLK_OFF)
+            goto held;
+        if (!pg_clk_mask(io, PG_GMU_CLK, PG_GMU_WAIT_MASK, gmu)) goto held;
+    }
+    cmd = pg_read(io, PG_GPUCC, PG_RCG);
+    if (cmd != PG_ROOT_OFF ||
+        (pg_read(io, PG_GPUCC, PG_RCG + 4) & PG_CFG_MASK) != (cfg & PG_CFG_MASK) ||
+        (pg_read(io, PG_GPUCC, PG_GMU_CLK) & (PG_CLK_OFF | PG_GMU_WAIT_MASK | 1u)) !=
+            (gmu & (PG_CLK_OFF | PG_GMU_WAIT_MASK | 1u)) ||
+        (pg_read(io, PG_GPUCC, PG_CXO_CLK) & 1u) != (cxo & 1u)) goto held;
+    pg_report(io, "clock probe final RCG", cmd, pg_read(io, PG_GPUCC, PG_RCG + 4));
+    pg_report(io, "clock probe final branches", pg_read(io, PG_GPUCC, PG_GMU_CLK),
+              pg_read(io, PG_GPUCC, PG_CXO_CLK));
+    pg_report(io, "clock probe restored (a=reset-verified)", verified ? 1u : 0u, 0);
+    return true;
+held:
+    pg_report(io, "clock probe restore failed; CX retained", 0, 0);
+    return false;
+}
+static bool pg_clock_probe(struct pg_io *io, void *arg)
+{ (void)arg; return pg_clock_probe_body(io, false, NULL, NULL); }
+static bool pg_bus_clock_probe(struct pg_io *io, void *arg)
+{ (void)arg; return pg_clock_probe_body(io, true, NULL, NULL); }
+/* A630 legacy flat ITCM load: Linux 21a7f44fd076 a6xx_gmu.c:894-904;
+ * MiCode c7cb50c18f81 adreno_a6xx.c:1803-1824. The extra snapshot and
+ * restoration are diagnostic ownership rules, not a firmware boot sequence.
+ */
+enum pg_itcm_result {
+    PG_ITCM_NOT_RUN, PG_ITCM_OK, PG_ITCM_BAD_INPUT, PG_ITCM_SNAPSHOT_UNSTABLE,
+    PG_ITCM_RETENTION_REJECTED, PG_ITCM_MISMATCH_RESTORED,
+    PG_ITCM_RESET_UNCERTAIN, PG_ITCM_RESTORE_FAILED, PG_ITCM_ACCESS_UNCERTAIN
+};
+struct pg_itcm_data {
+    const uint32_t *firmware;
+    uint32_t *saved;
+    enum pg_itcm_result result;
+    bool modified;
+};
+static bool pg_itcm_input_valid(const struct pg_itcm_data *t)
+{
+    uintptr_t fw, saved, distance;
+    if (t == NULL || t->firmware == NULL || t->saved == NULL) return false;
+    fw = (uintptr_t)t->firmware;
+    saved = (uintptr_t)t->saved;
+    distance = fw > saved ? fw - saved : saved - fw;
+    if (((fw | saved) & 3u) || distance < PG_GMU_BLOB_SIZE) return false;
+    return t->firmware[0] >= 0x40000u && t->firmware[0] < 0x50000u &&
+        !(t->firmware[0] & 3u) && (t->firmware[1] & 1u) &&
+        (t->firmware[1] & ~1u) < PG_GMU_BLOB_SIZE;
+}
+static bool pg_itcm_reset(struct pg_io *io, struct pg_itcm_data *t)
+{
+    uint32_t reset = pg_read(io, PG_GMU, PG_RESET);
+    if (reset == 1u) return true;
+    pg_report(io, "ITCM reset uncertain; dependencies retained", reset, 0);
+    t->result = PG_ITCM_RESET_UNCERTAIN;
+    return false;
+}
+static bool pg_itcm_restore_retention(struct pg_io *io,
+                                      struct pg_itcm_data *t, uint32_t before)
+{
+    uint32_t now;
+    if (!pg_itcm_reset(io, t)) return false;
+    now = pg_read(io, PG_GMU, PG_RETENTION);
+    /* Preserve an inherited request and never overwrite an unexpected field. */
+    if (now == before) return true;
+    if (now != (before | 1u) || (before & 1u)) return false;
+    pg_write(io, PG_GMU, PG_RETENTION, now & ~1u);
+    return pg_read(io, PG_GMU, PG_RETENTION) == before;
+}
+static bool pg_itcm_transfer(struct pg_io *io, void *arg)
+{
+    struct pg_itcm_data *t = arg;
+    uint32_t retention, hw, bad = 0;
+    if (!pg_itcm_input_valid(t)) {
+        if (t != NULL) t->result = PG_ITCM_BAD_INPUT;
+        return true; /* no TCM access or changes */
+    }
+    t->result = PG_ITCM_ACCESS_UNCERTAIN;
+    /* Called inside the owned bus transaction. Recheck access before GMU MMIO. */
+    if ((pg_read(io, PG_GCC, PG_GCC_AHB) & (PG_CLK_OFF | 1u)) != 1u ||
+        !pg_cx_on(pg_read(io, PG_GPUCC, PG_CX_GDSCR)) ||
+        (pg_read(io, PG_GPUCC, PG_GMU_CLK) & (PG_CLK_OFF | 1u)) != 1u ||
+        (pg_read(io, PG_GPUCC, PG_CXO_CLK) & (PG_CLK_OFF | 1u)) != 1u)
+        return false;
+    hw = pg_read(io, PG_GPUCC, PG_CX_HW);
+    if (hw == 0xffffffffu || !(hw & PG_GDSC_PWR_ON) ||
+        pg_read(io, PG_GPUCC, PG_RCG) != 0 ||
+        (pg_read(io, PG_GPUCC, PG_RCG + 4) & PG_CFG_MASK) != PG_XO_CFG)
+        return false;
+    for (unsigned int i = 0; i < 3; ++i)
+        if ((pg_read(io, PG_GCC, pg_bus_offsets[i]) & (PG_CLK_OFF | 1u)) != 1u)
+            return false;
+    if (!pg_itcm_reset(io, t)) return false;
+    retention = pg_read(io, PG_GMU, PG_RETENTION);
+    pg_report(io, "ITCM retention inherited", retention, 0);
+    if (retention == 0xffffffffu) return false;
+    /* Save and double-check the original contents before any GMU write. */
+    for (unsigned int i = 0; i < PG_WORDS; ++i) {
+        if (!(i & 255u) && !pg_itcm_reset(io, t)) return false;
+        t->saved[i] = pg_read(io, PG_GMU, PG_ITCM + 4u * i);
+    }
+    for (unsigned int i = 0; i < PG_WORDS; ++i) {
+        if (!(i & 255u) && !pg_itcm_reset(io, t)) return false;
+        if (pg_read(io, PG_GMU, PG_ITCM + 4u * i) != t->saved[i]) ++bad;
+    }
+    pg_report(io, "ITCM snapshot stable words/mismatches", PG_WORDS - bad, bad);
+    if (bad) { t->result = PG_ITCM_SNAPSHOT_UNSTABLE; return false; }
+    if (!pg_itcm_reset(io, t)) return false;
+    if (pg_read(io, PG_GMU, PG_RETENTION) != retention) return false;
+    if (!(retention & 1u)) pg_write(io, PG_GMU, PG_RETENTION, retention | 1u);
+    if (pg_read(io, PG_GMU, PG_RETENTION) != (retention | 1u)) {
+        t->result = PG_ITCM_RETENTION_REJECTED;
+        if (pg_itcm_restore_retention(io, t, retention)) return true;
+        if (t->result != PG_ITCM_RESET_UNCERTAIN) t->result = PG_ITCM_RESTORE_FAILED;
+        return false;
+    }
+    if (!pg_itcm_reset(io, t)) return false;
+    for (unsigned int i = 0; i < PG_WORDS; ++i) {
+        if (!(i & 255u) && !pg_itcm_reset(io, t)) return false;
+        t->modified = true;
+        pg_write(io, PG_GMU, PG_ITCM + 4u * i, t->firmware[i]);
+    }
+    bad = 0;
+    for (unsigned int i = 0; i < PG_WORDS; ++i) {
+        uint32_t got;
+        if (!(i & 255u) && !pg_itcm_reset(io, t)) return false;
+        got = pg_read(io, PG_GMU, PG_ITCM + 4u * i);
+        if (got != t->firmware[i]) {
+            if (bad < 4) pg_report(io, "ITCM firmware mismatch index/value", i, got);
+            ++bad;
+        }
+    }
+    pg_report(io, "ITCM firmware verified words/mismatches", PG_WORDS - bad, bad);
+    t->result = bad ? PG_ITCM_MISMATCH_RESTORED : PG_ITCM_OK;
+    if (!pg_itcm_reset(io, t)) return false;
+    if (pg_read(io, PG_GMU, PG_RETENTION) != (retention | 1u)) {
+        t->result = PG_ITCM_RESTORE_FAILED;
+        return false;
+    }
+    for (unsigned int i = 0; i < PG_WORDS; ++i) {
+        if (!(i & 255u) && !pg_itcm_reset(io, t)) return false;
+        pg_write(io, PG_GMU, PG_ITCM + 4u * i, t->saved[i]);
+    }
+    bad = 0;
+    for (unsigned int i = 0; i < PG_WORDS; ++i) {
+        if (!(i & 255u) && !pg_itcm_reset(io, t)) return false;
+        if (pg_read(io, PG_GMU, PG_ITCM + 4u * i) != t->saved[i]) ++bad;
+    }
+    pg_report(io, "ITCM original restored words/mismatches", PG_WORDS - bad, bad);
+    if (bad) { t->result = PG_ITCM_RESTORE_FAILED; return false; }
+    if (!pg_itcm_restore_retention(io, t, retention)) {
+        if (t->result != PG_ITCM_RESET_UNCERTAIN) t->result = PG_ITCM_RESTORE_FAILED;
+        return false;
+    }
+    if (!pg_itcm_reset(io, t)) return false;
+    t->modified = false;
+    pg_report(io, "ITCM transaction restored; CM3 remains reset", retention, t->result);
+    return true;
+}
+static bool pg_itcm_clock_probe(struct pg_io *io, void *arg)
+{ return pg_clock_probe_body(io, true, pg_itcm_transfer, arg); }
+static enum pg_cx_result pg_owned_itcm_test(struct pg_io *io, struct pg_itcm_data *t)
+{
+    if (!pg_itcm_input_valid(t)) {
+        if (t != NULL) t->result = PG_ITCM_BAD_INPUT;
+        pg_report(io, "ITCM invalid buffers/vectors; no power transition", 0, 0);
+        return PG_CX_INPUT_REJECTED;
+    }
+    t->result = PG_ITCM_NOT_RUN;
+    t->modified = false;
+    return pg_cx_cycle_with_probe(io, pg_itcm_clock_probe, t);
+}
+
+
+/* saved must hold PG_WORDS words; firmware and saved must not alias. */
+static enum pg_result
+pg_tcm_test(struct pg_io *io, const uint32_t *firmware, uint32_t *saved)
+{
+    uint32_t cx, hw, old_gmu, old_cxo, old_cfg, retention = 0, mismatches = 0;
+    bool cfg_changed = false, cxo_changed = false, gmu_changed = false;
+    bool retention_changed = false, tcm_changed = false, restore_ok = true;
+    enum pg_result result = PG_CLOCK_ERROR;
+    if (firmware == NULL || saved == NULL || firmware == saved ||
+        firmware[0] < 0x40000u || firmware[0] >= 0x50000u ||
+        (firmware[0] & 3u) || !(firmware[1] & 1u) ||
+        (firmware[1] & ~1u) >= PG_WORDS * 4u) return PG_BAD_FW;
+    if (pg_read(io, PG_GCC, PG_GCC_AHB) & PG_CLK_OFF) return PG_NO_AHB;
+    cx = pg_read(io, PG_GPUCC, PG_CX_GDSCR);
+    /* GDSCR must pass before even reading the hardware status alias. */
+    if (!pg_cx_on(cx)) return PG_NO_CX;
+    hw = pg_read(io, PG_GPUCC, PG_CX_HW);
+    pg_report(io, "CX inherited", cx, hw);
+    /* No regulator/RPMh owner exists here; never power an off domain. */
+    if (!(hw & PG_GDSC_PWR_ON)) return PG_NO_CX;
+    old_gmu = pg_read(io, PG_GPUCC, PG_GMU_CLK);
+    old_cxo = pg_read(io, PG_GPUCC, PG_CXO_CLK);
+    old_cfg = pg_read(io, PG_GPUCC, PG_RCG + 4);
+    pg_report(io, "clocks inherited", old_gmu, old_cxo);
+    /* A clock enabled or running at handoff could belong to live firmware. */
+    if ((old_gmu & 1u) || !(old_gmu & PG_CLK_OFF) ||
+        (pg_read(io, PG_GPUCC, PG_RCG) & 1u)) return PG_BUSY;
+    /* XO 19.2 MHz is an SDM845 GMU source. No PLL or voltage increase. */
+    if ((old_cfg & PG_CFG_MASK) != PG_XO_CFG) {
+        cfg_changed = true;
+        if (!pg_update_rcg(io, PG_XO_CFG)) goto restore;
+    }
+    if (!(old_cxo & 1u)) {
+        cxo_changed = true;
+        pg_masked(io, PG_CXO_CLK, 1u, 1u);
+    }
+    if (!pg_poll(io, PG_GPUCC, PG_CXO_CLK, PG_CLK_OFF, 0)) goto restore;
+    gmu_changed = true;
+    pg_masked(io, PG_GMU_CLK, 1u, 1u);
+    if (!pg_poll(io, PG_GPUCC, PG_GMU_CLK, PG_CLK_OFF, 0)) goto restore;
+    pg_report(io, "XO clocks ready", pg_read(io, PG_GPUCC, PG_RCG + 4),
+              pg_read(io, PG_GPUCC, PG_GMU_CLK));
+    /* Never assert reset on possibly active firmware; require reset already held. */
+    if (pg_read(io, PG_GMU, PG_RESET) != 1u) {
+        result = PG_NOT_RESET;
+        goto restore;
+    }
+    /* Snapshot ITCM while CM3 is still held in reset, before changing
+     * retention. This makes the restore source independent of the test write. */
+    for (unsigned int i = 0; i < PG_WORDS; i++)
+        saved[i] = pg_read(io, PG_GMU, PG_ITCM + 4u * i);
+    retention = pg_read(io, PG_GMU, PG_RETENTION);
+    if (!(retention & 1u)) {
+        retention_changed = true;
+        pg_write(io, PG_GMU, PG_RETENTION, retention | 1u);
+    }
+    if (!(pg_read(io, PG_GMU, PG_RETENTION) & 1u)) {
+        result = PG_RETAIN_ERROR;
+        goto restore;
+    }
+    tcm_changed = true;
+    for (unsigned int i = 0; i < PG_WORDS; i++)
+        pg_write(io, PG_GMU, PG_ITCM + 4u * i, firmware[i]);
+    for (unsigned int i = 0; i < PG_WORDS; i++) {
+        uint32_t got = pg_read(io, PG_GMU, PG_ITCM + 4u * i);
+        if (got != firmware[i]) {
+            if (mismatches < 4) pg_report(io, "ITCM mismatch", i, got);
+            mismatches++;
+        }
+    }
+    pg_report(io, "ITCM firmware readback", PG_WORDS - mismatches, mismatches);
+    result = mismatches ? PG_VERIFY_ERROR : PG_OK;
+restore:
+    if (tcm_changed) {
+        uint32_t bad = 0;
+        /* Firmware was never released; restore the pre-test TCM contents. */
+        for (unsigned int i = 0; i < PG_WORDS; i++)
+            pg_write(io, PG_GMU, PG_ITCM + 4u * i, saved[i]);
+        for (unsigned int i = 0; i < PG_WORDS; i++)
+            if (pg_read(io, PG_GMU, PG_ITCM + 4u * i) != saved[i]) bad++;
+        pg_report(io, "ITCM restore readback", PG_WORDS - bad, bad);
+        restore_ok = bad == 0;
+    }
+    if (retention_changed) {
+        pg_write(io, PG_GMU, PG_RETENTION, retention);
+        restore_ok = pg_read(io, PG_GMU, PG_RETENTION) == retention && restore_ok;
+    }
+    if (gmu_changed) {
+        pg_masked(io, PG_GMU_CLK, 1u, old_gmu);
+        restore_ok = pg_poll(io, PG_GPUCC, PG_GMU_CLK, PG_CLK_OFF, PG_CLK_OFF) && restore_ok;
+    }
+    if (cfg_changed) {
+        /* A stuck RCG/clock must not be reconfigured while still running. */
+        if ((pg_read(io, PG_GPUCC, PG_GMU_CLK) & PG_CLK_OFF) &&
+            !(pg_read(io, PG_GPUCC, PG_RCG) & 1u))
+            restore_ok = pg_update_rcg(io, old_cfg) && restore_ok;
+        else restore_ok = false;
+    }
+    if (cxo_changed) {
+        pg_masked(io, PG_CXO_CLK, 1u, old_cxo);
+        restore_ok = (pg_read(io, PG_GPUCC, PG_CXO_CLK) & 1u) == (old_cxo & 1u) && restore_ok;
+    }
+    pg_report(io, "restored clocks", pg_read(io, PG_GPUCC, PG_GMU_CLK),
+              pg_read(io, PG_GPUCC, PG_CXO_CLK));
+    return restore_ok ? result : PG_RESTORE_ERROR;
+}
+
+/* Verify the boot-time blob lies in XNU's high-memory RAM map before static mapping. */
+static bool pg_blob_range_valid(uint64_t dram, uint64_t size, uint64_t pa, uint64_t len)
+{
+    uint64_t off;
+    if (dram != PG_DRAM_BASE ||
+        (size != PG_DRAM_SIZE6 && size != PG_DRAM_SIZE8) ||
+        len != PG_GMU_BLOB_SIZE || (pa & 0x3fffu) || pa < dram)
+        return false;
+    off = pa - dram;
+    return off <= size && len <= size - off;
+}
